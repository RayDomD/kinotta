{
  "name": "kinotta",
  "version": "0.1.0",
  "description": "A review editor for AI-made motion graphics and footage edits.",
  "private": true,
  "type": "module",
  "bin": {
    "kinotta": "bin/kinotta.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "vite build --config vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "install-skill": "node scripts/install-skill.mjs"
  },
  "dependencies": {
    "@fontsource/doto": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "node-html-parser": "^9.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
